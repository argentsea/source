  "fields": {
    "name": "Shard key type metadata",
    "definition": "An encoded marker of the record-key generic type(s) embedded in every ShardKey and its serialized forms. Deserialization validates it against the expected generic types, preventing a key of one record type from being mistaken for another. It replaces the DataOrigin char that identified key domains in earlier versions and older documentation.",
    "synonyms": [
      "type metadata",
      "DataOrigin (obsolete)"
    ]
  },
