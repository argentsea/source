  "fields": {
    "name": "Shards values",
    "definition": "The optional targeting argument (`ShardsValues`) of a shard-set query. It lists the shard ids to query, and each listed shard can carry parameter values that override the shared parameters on that shard only. When supplied, only the listed shards are queried, and an empty set queries none. When omitted, every shard in the set is queried with the same parameters.",
    "synonyms": [
      "ShardsValues",
      "ShardParameterValue",
      "shard parameter values"
    ]
  },
