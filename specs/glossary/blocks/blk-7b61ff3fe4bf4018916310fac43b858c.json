  "fields": {
    "name": "Model",
    "definition": "An application class whose properties carry mapping attributes. It serves as the source of a query's parameters or the target of its results. A model inherits the mapping attributes of its base classes. It may nest other models (nested model), hold result-set list properties, and expose its identity as a keyed model.",
    "synonyms": [
      "Model class",
      "TModel"
    ]
  },
