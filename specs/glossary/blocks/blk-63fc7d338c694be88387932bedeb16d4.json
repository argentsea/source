  "fields": {
    "name": "COPY load",
    "definition": "PostgreSQL bulk loading in which ArgentSea streams a list of models into a table or temporary table with `COPY` through Npgsql's binary importer. The column definitions are derived from the models' mapping attributes. It runs as a batch step, so a following step can process the loaded rows in the same transaction.",
    "synonyms": [
      "CopyMapper",
      "binary import",
      "NpgsqlBinaryImporter"
    ]
  },
