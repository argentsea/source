  "fields": {
    "name": "Mock results",
    "definition": "A dictionary on a data connection, shard or shard set, keyed by Query name. When a data method is invoked with a Query whose name is present, the stored object is returned as the result and no database call is made. It lets unit tests exercise application code through ArgentSea's real call path without a live database.",
    "synonyms": [
      "MockResults",
      "canned results"
    ]
  },
