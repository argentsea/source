  "fields": {
    "name": "Mock results",
    "definition": "A per-connection (or per-shard-set) dictionary, keyed by query contract name, that short-circuits query execution: when a key matches the invoked query, the stored object is returned as the result and no database call occurs. Enables unit tests to exercise the real ArgentSea call path without a live database.",
    "synonyms": [
      "MockResults",
      "canned results"
    ]
  },
