  "type": "Term",
  "fields": {
    "definition": "A SQL Server structured parameter (`SqlDbType.Structured`) that carries a set of rows to save many records in one round trip. ArgentSea builds one from a sequence of models (converted to `SqlDataRecord` rows by the compiled `TvpMapper`) via `AddSqlTableValuedParameter`, or from a collection property marked with `[MapToSqlTableValuedParameter]`. An empty or null row set is sent with `Value = null`.",
    "name": "Table-valued parameter",
    "synonyms": [
      "TVP",
      "TvpMapper"
    ]
  },
