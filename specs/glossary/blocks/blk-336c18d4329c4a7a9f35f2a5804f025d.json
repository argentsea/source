  "fields": {
    "name": "Table-valued parameter",
    "definition": "A SQL Server parameter that carries a set of rows, used to save many records in one round trip. ArgentSea builds one from a list of models, with each model converted to a `SqlDataRecord` by the compiled TVP mapper, or from a collection property marked with a collection mapping attribute. An empty or null row set is sent as a null parameter value.",
    "synonyms": [
      "TVP",
      "TvpMapper"
    ]
  },
