  "fields": {
    "name": "Mapping attribute",
    "definition": "A provider-specific attribute placed on a model property (e.g. MapToSqlNVarChar, MapToPgVarchar) that declares the parameter or column the property binds to. The Mapper compiles these declarations into cached expression trees that set parameters and read results at near hand-coded ADO.NET speed.",
    "synonyms": [
      "MapTo attribute",
      "property mapping attribute"
    ]
  },
