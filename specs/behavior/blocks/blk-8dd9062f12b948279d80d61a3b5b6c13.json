  "fields": {
    "gwt": {
      "given": "a KeyStep<TRecord> was added to a batch via BatchExtensions.Add without a shardIdColumnName, and the batch is executing on shard 7",
      "when": "the step's query returns one row containing only the record-id column",
      "then": "the step returns a ShardKey<TRecord> whose shard id is 7 — the shardId passed into ExecuteAsync — not a value read from the row"
    },
