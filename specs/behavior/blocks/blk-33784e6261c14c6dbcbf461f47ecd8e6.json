  "fields": {
    "subject": "CopyMapper",
    "condition": "a Batch has an operation registered through a virtual compound key Add overload and the supplied table name is valid",
    "trigger": "the Batch executes that operation",
    "response": "create the destination table and import one binary COPY row per key, placing its shard identifier and record identity first, followed by each supplied child, grandchild, and great-grandchild identity in key-arity order",
    "postcondition": "the COPY columns use the PgParameterMapAttribute definitions supplied for the identity members"
  },
