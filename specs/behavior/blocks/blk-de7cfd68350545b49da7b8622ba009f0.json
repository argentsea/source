  "fields": {
    "gwt": {
      "given": "a service provider with the SqlDatabases collection registered as a singleton and OrleansDbPersistenceOptions registered for provider name \"orders-db\"",
      "when": "ArgentSeaGrainStorageFactory.CreateDb is called with that service provider and \"orders-db\"",
      "then": "the returned IGrainStorage is constructed from the SqlDatabases singleton and the OrleansDbPersistenceOptions resolved by name for \"orders-db\" — SqlDatabases itself is resolved as the singleton collection, not looked up by provider name"
