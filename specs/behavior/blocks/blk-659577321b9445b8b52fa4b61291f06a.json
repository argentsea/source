  "fields": {
    "gwt": {
      "given": "a model class maps a ReadOnlyMemory<byte> property Payload with [MapToSqlVarBinary(\"Payload\", 100)]",
      "when": "CreateInputParameters (or TvpMapper.ToTvpRecord) builds that model's mapping for the first time",
      "then": "MapToSqlVarBinaryAttribute.IsValidType returns false for ReadOnlyMemory<byte> and the mapping build throws InvalidMapTypeException before any parameter or row expression is generated; the same holds for Memory<byte>, and IsValidType likewise returns false for ReadOnlySpan<byte> and Span<byte>, while byte[] is accepted"
    },
