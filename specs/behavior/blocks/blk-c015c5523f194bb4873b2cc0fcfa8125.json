  "fields": {
    "gwt": {
      "given": "a logger with Information enabled, and an uninitialized ShardKey<string, int> (default, so RecordId is null) mapped for property \"ChildKey\"; and separately a ShardKey<int, int>(0, 5, 0) whose identities are value-typed",
      "then": "the uninitialized string-keyed ShardKey produces one Information-level UnexpectedDbNull (event id 6) event named NullShardChildArguments, carrying \"ChildKey\" and the key's string form without throwing; the value-typed ShardKey<int, int> produces no event",
      "when": "NullShardChildArguments(logger, \"ChildKey\", shardChild) is called with each key"
    },
