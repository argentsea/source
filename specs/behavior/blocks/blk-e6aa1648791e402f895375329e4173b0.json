  "specId": "behavior",
  "type": "Behavioral",
  "fields": {
    "subject": "Resilient Command Execution",
    "trigger": "the data provider's transient-error classifier reports that a DbException thrown while executing a command on a connection is transient",
    "response": "retry the execution, waiting before each attempt the backoff interval the connection's resilience settings compute for that attempt number, up to the connection's configured retry count",
    "postcondition": "a transient failure that clears within the retry budget never surfaces to the caller"
  },
