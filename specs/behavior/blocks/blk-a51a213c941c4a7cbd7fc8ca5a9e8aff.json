{
  "id": "blk-a51a213c941c4a7cbd7fc8ca5a9e8aff",
  "specId": "behavior",
  "type": "Scenario",
  "fields": {
    "gwt": {
      "given": "a command's source DbParameterCollection contains one NpgsqlParameter \"@id\" whose Value is 7, and SetParameters is called with queryParameterNames null and a parameterValues dictionary containing {\"@id\": 99}",
      "when": "the Postgres DataProviderServiceFactory.SetParameters applies parameters to the command",
      "then": "the command's \"@id\" parameter ends up with Value 99 — the parameterValues entry replaces the cloned source value and is the value bound on the command — while the source collection's \"@id\" parameter still holds 7"
    },
