  "fields": {
    "condition": "the host logger has Trace enabled",
    "postcondition": "nothing is formatted or logged when Trace is disabled; a call that throws before its query completes logs no timing event",
    "response": "log the elapsed milliseconds and grain type at Trace under event id CmdExecuted (8): the database-backed provider through TraceDbReadCmdExecuted, TraceDbWriteCmdExecuted and TraceDbClearCmdExecuted; the shard provider through TraceShardReadCmdExecuted, TraceShardWriteCmdExecuted and TraceShardClearCmdExecuted, which also carry the id of the shard the query ran on",
    "subject": "Grain Persistence",
    "trigger": "a ReadStateAsync, WriteStateAsync or ClearStateAsync call completes its query"
  },
