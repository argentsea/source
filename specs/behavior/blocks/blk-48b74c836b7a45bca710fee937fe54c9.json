  "specId": "behavior",
  "type": "Behavioral",
  "fields": {
    "subject": "Model Mapping",
    "where": "a model property of reference type carries the MapToModel attribute (which may be applied once, to properties only, and is not inherited by overriding properties) and no parameter mapping attribute",
    "trigger": "the Mapper compiles that model type's input-parameter, output-parameter-declaration, output-parameter-read or data-reader delegate",
    "response": "recurse into the nested model's own mapped properties and flatten them into the same parameter set or result row as the parent; and, for input-parameter creation, output-parameter reads and reader reads, assign a new instance of the property's type to the property when it is writable and currently null before accessing the nested properties",
    "postcondition": "a nested model maps to the same parameters or columns as if its attributes were declared on the parent, to any depth; a MapToModel property whose type is a value type is skipped"
  },
