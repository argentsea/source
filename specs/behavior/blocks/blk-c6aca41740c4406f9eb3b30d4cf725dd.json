  "id": "blk-c6aca41740c4406f9eb3b30d4cf725dd",
  "specId": "behavior",
  "type": "Behavioral",
  "fields": {
    "response": "TraceDbCmdExecuted and TraceShardCmdExecuted each check logger.IsEnabled(LogLevel.Trace) and, only when Trace is enabled, invoke their compiled Trace-level delegate, logging the command name, connection or shard-set/shard identifiers, and elapsed milliseconds under event id CmdExecuted (8). BuildSqlResultsHandlerScope opens a disposable logging scope, compiled via LoggerMessage.DefineScope, carrying the stored-procedure name and result-model Type, until the caller disposes it.",
    "subject": "Core Log Events",
    "trigger": "code elsewhere in the library invokes TraceDbCmdExecuted(this ILogger logger, string commandName, string connectionName, long milliseconds), TraceShardCmdExecuted(this ILogger logger, string commandName, string shardSetKey, short shardId, long milliseconds), or BuildSqlResultsHandlerScope(this ILogger logger, string procedureName, Type model)"
  },
