  "type": "Scenario",
  "fields": {
    "gwt": {
      "given": "A DataConnectionConfigurationBase instance's Password property currently holds the value \"OldP@ss1\".",
      "when": "The caller assigns Password the different value \"NewP@ss2\".",
      "then": "The setter's value-changed check passes, Password is updated, the instance raises PropertyChanged with PropertyChangedEventArgs.PropertyName equal to \"Password\", and a Data connection holding this configuration level recomputes its resolved connection settings rather than reusing the ones resolved before the change."
    },
