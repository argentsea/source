  "fields": {
    "subject": "Postgres Connection Settings",
    "condition": "the shard collection or a read/write configuration has been assigned on a PgShardConnectionOptions.PgShardConnectionsConfiguration",
    "trigger": "a consumer reads ShardsConfigInternal, ReadConfigInternal, or WriteConfigInternal on that PgShardConnectionOptions.PgShardConnectionsConfiguration",
    "response": "expose Shards, Read, or Write respectively through the corresponding IShardSetConnectionsConfiguration view without substituting or copying the configured object or collection",
    "postcondition": "the returned view has the same object identity as the corresponding concrete configuration value"
  },
