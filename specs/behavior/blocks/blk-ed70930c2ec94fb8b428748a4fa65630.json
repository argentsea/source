    "subject": "ShardSetsBase<TConfiguration>.ShardSetReadFirst",
    "condition": "a query contract targets either every shard in a shard set or the shard entries supplied by ShardsValues",
    "trigger": "a caller invokes QueryAsync, MapReaderAsync, or MapOutputAsync with its parameters",
    "response": "start a read for every target shard and complete with the first non-null TModel produced by any target shard",
    "postcondition": "after a non-null result is obtained, remaining target reads are cancelled; an empty target selection or an all-null set of completed reads yields default(TModel)"
  },
