  "fields": {
    "gwt": {
      "given": "A DbParameterCollection has no parameters and a query contract needs a Float input named \"score\" with value NaN.",
      "when": "A caller invokes SqlParameterCollectionExtensions.AddSqlFloatInputParameter(collection, \"score\", double.NaN).",
      "then": "The same collection contains one Input Float parameter named \"@score\" whose value is DBNull."
