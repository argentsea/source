    "subject": "SequenceLengthening",
    "where": "a retry backoff has a base interval and an attempt number",
    "trigger": "retry-delay resolution selects a SequenceLengthening value",
    "response": "map Linear to attempt × interval, HalfSquare to floor(attempt² / 2) × interval, Squaring to 2^(attempt − 1) × interval, and Fibonacci or an unrecognized value to (attempt + attempt − 1) × interval",
    "postcondition": "the resulting duration is returned in milliseconds"
  },
