  "fields": {
    "subject": "Shard Key Orleans Codecs",
    "trigger": "a caller writes or reads a virtual compound key of any supported arity through ShardKeyOrleansSerializer<...>",
    "condition": "the field is being handled via Orleans's object-reference wire encoding instead of the key's own byte payload",
    "response": "on write, no length byte or key bytes are written for that field; on read, when the field's WireType is Reference, no length byte or key bytes are read either, and the value is resolved entirely through Orleans's reference-field handling",
    "postcondition": "no ShardKey byte payload is written to or read from the wire for that occurrence of the field"
  },
