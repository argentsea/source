{
  "id": "blk-bbbe2422fa1544c7b49ba3db91fe44ef",
  "specId": "behavior",
  "type": "Behavioral",
  "fields": {
    "subject": "Batch Execution",
    "trigger": "a ShardBatch or DatabaseBatch executes on an open connection",
    "response": "invoke each registered BatchStep's ExecuteAsync one at a time, in registration order and awaiting each before the next, passing every step the same connection, transaction, connection name, data provider services, logger and cancellation token, together with the shard id the batch is executing for (ShardBatch) or 0 (DatabaseBatch); a query-backed step passes that cancellation token on to its command execution, so cancelling the batch is observed while a step's command is running, not only between steps",
    "postcondition": "all steps of one batch run sequentially inside the single transaction the batch owns, so their work commits or rolls back together"
  },
