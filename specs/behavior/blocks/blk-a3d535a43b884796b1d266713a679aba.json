  "fields": {
    "gwt": {
      "given": "a model class maps one property with MapToSqlJsonAttribute, and that model's rows are being compiled into a table-valued-parameter mapper",
      "when": "the compiler builds the table-valued-parameter row expression for the Json-mapped property (AppendTvpExpressions executes on the MapToSqlJsonAttribute instance)",
      "then": "construction throws a NotImplementedException whose message is \"Json data type is not implemented in ADO.NET for table-valued functions.\""
    },
