  "fields": {
    "gwt": {
      "given": "A ShardsValues instance was constructed via ShardsValues(IList<short> list) with an empty list, so its Shards property is null.",
      "when": "The caller begins enumerating the instance directly, e.g. foreach (var item in shardsValues).",
      "then": "The first MoveNext call on the explicit IEnumerable<ShardParameterValue>.GetEnumerator() iterator throws a System.NullReferenceException because its foreach (var shd in Shards) dereferences the null Shards dictionary; no element is yielded."
