  "fields": {
    "subject": "Batch Execution",
    "where": "a key-producing or child-key-producing step was added without a shard-identifier column name",
    "trigger": "the step maps a returned row into its ShardKey result",
    "response": "use the shardId value supplied to that execution as the record's shard identifier instead of reading a shard-identifier column from the row; a ShardBatch supplies the shard id of the shard it runs on, while a DatabaseBatch always supplies 0, because it runs only on a non-sharded database connection, whose shard id is always 0",
    "postcondition": "the resulting ShardKey's shard id equals the execution's shardId parameter, which is 0 for every step of a DatabaseBatch"
  },
