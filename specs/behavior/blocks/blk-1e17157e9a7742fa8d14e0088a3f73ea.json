  "type": "Scenario",
  "fields": {
    "gwt": {
      "given": "a model class maps TimeOnly WakeTime = 06:30:15 and TimeOnly? SnoozeTime = null with [MapToSqlTime(\"WakeTime\")] and [MapToSqlTime(\"SnoozeTime\")]",
      "when": "the model is mapped to input parameters, to a table-valued-parameter row, and back from Time output parameters whose values the provider returns as TimeSpan",
      "then": "@WakeTime is a Time input parameter whose value is the TimeSpan 06:30:15 and @SnoozeTime carries DBNull; the table-valued-parameter row holds TimeSpan 06:30:15 (written with SetTimeSpan) and a database null; reading output values TimeSpan 06:30:15 and DBNull yields WakeTime = TimeOnly 06:30:15 and SnoozeTime = null"
    },
