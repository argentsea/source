  "fields": {
    "gwt": {
      "given": "MapPgShardKeyAttribute is needed for a virtual compound key whose shard identifier is named \"ShardId\" and whose record and child identities are named \"RecordId\" and \"ChildId\".",
      "when": "new MapPgShardKeyAttribute(\"ShardId\", \"RecordId\", \"ChildId\", false) is constructed.",
      "then": "MapPgShardKeyAttribute exposes \"ShardId\", \"RecordId\", and \"ChildId\" as its shard, record, and child selectors; its shard parameter is a PostgreSQL smallint mapping; and its record-identifier selector is false."
    },
