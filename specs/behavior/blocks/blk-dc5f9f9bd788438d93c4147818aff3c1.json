  "specId": "behavior",
  "type": "Behavioral",
  "fields": {
    "subject": "Shard Key",
    "trigger": "ShardKey<...>: a caller reads IsEmpty, or obtains Empty, on a ShardKey of any arity",
    "response": "report IsEmpty as true only when its shard identifier is zero and every identity position equals that position type's empty value — a zero-length string for a string identity, a zero-length byte array for a binary identity, or the type's default value otherwise — treating a null identity position (as in an uninitialized struct) as empty; Empty is built from the same per-type empty values",
    "postcondition": "all four arities apply one empty-value rule, so Empty.IsEmpty is true at every arity and an empty-string key reports the same IsEmpty result regardless of arity"
  },
