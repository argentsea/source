  "fields": {
    "postcondition": "the packed bytes are written even when the call returns false, with any Undefined part encoded as zero",
    "response": "pack each key part's KeyDataType code (from GetKeyDataType) into a byte sequence sized by arity -- 1 byte for one part, 2 bytes for two, and 3 bytes for three or four parts -- and return true only when every supplied type encoded to a non-Undefined code",
    "subject": "ShardKeySerialization",
    "trigger": "a caller requests encoded type metadata for a 1-to-4-part key via TryEncodeTypeMetadata"
  },
