  "type": "Scenario",
  "fields": {
    "gwt": {
      "given": "A caller calls QueryStatement.Create(\"Foo\") while QueryStatement.Extension is \"sql\", then reassigns QueryStatement.Extension to \"psql\" before ever reading Value.",
      "when": "The caller then evaluates Value on the returned Lazy<QueryStatement>.",
      "then": "The statement text is read from the Foo.psql file, not Foo.sql, because Extension was read at Value-evaluation time."
    },
