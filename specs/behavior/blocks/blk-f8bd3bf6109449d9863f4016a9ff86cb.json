  "type": "Behavioral",
  "fields": {
    "postcondition": "repeated conversions of the same model type reuse the cached compiled projection delegate instead of rebuilding it from reflection on every call",
    "response": "lazily compile and cache that model type's table-valued-record projection delegate behind a cached Lazy<Delegate>, reusing the compiled delegate on subsequent calls for the same type and logging whether the cached delegate was already initialized (cache hit) or newly compiled (cache miss)",
    "subject": "Table Valued Parameters",
    "trigger": "ToTvpRecord<TModel> is called for a model type"
  },
