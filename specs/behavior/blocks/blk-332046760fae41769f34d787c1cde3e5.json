  "fields": {
    "gwt": {
      "given": "a PostgreSQL connection whose connection string is \"Host=db;Database=app;Multiplexing = true\" (whitespace around '=' that Npgsql accepts)",
      "when": "the Postgres DataProviderServiceFactory.SetParameters applies parameters to a command on that connection",
      "then": "the command is NOT prepared — NpgsqlCommand.Prepare() is not called — because NpgsqlConnectionStringBuilder parses the connection string with Multiplexing = true"
    },
