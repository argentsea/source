  "fields": {
    "title": "OrleansSqlPersistence registers shard-set grain storage by name",
    "gwt": {
      "given": "an IServiceCollection and provider name \"catalog\"",
      "when": "the caller invokes AddArgentSeaShardOrleansGrainStorage(\"catalog\", configure)",
      "then": "the same IServiceCollection is returned and it registers grain storage named \"catalog\" with the shard-set factory after applying configure to the named shard persistence options"
