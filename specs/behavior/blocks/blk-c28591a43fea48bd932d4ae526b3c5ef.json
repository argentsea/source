    "gwt": {
      "given": "A DbParameterCollection has no parameters and two virtual compound keys contain (ShardId=7, RecordId=101) and (ShardId=8, RecordId=102).",
      "when": "A caller invokes SqlParameterCollectionExtensions.AddSqlTableValuedParameter with column names \"ShardId\" and \"RecordId\" and their SQL types.",
      "then": "The same collection contains one Input Structured parameter with an @-prefixed name and two rows ordered [7,101] then [8,102]."
