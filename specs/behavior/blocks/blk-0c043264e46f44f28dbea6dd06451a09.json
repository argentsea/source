  "fields": {
    "subject": "CopyMapper",
    "condition": "a Batch has an operation registered through a model-collection Add overload and the supplied table name is valid",
    "trigger": "the Batch executes that operation",
    "response": "create the destination table, using a transaction-local table that drops on commit for an unqualified name and a persistent table for a schema-qualified name, then import one binary COPY row for each supplied model using its mapped properties",
    "postcondition": "the binary import is completed after all supplied models have been written"
  },
