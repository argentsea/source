  "fields": {
    "subject": "Query Parameters",
    "condition": "a caller extracts a required Guid value from a Query contract parameter whose value is DBNull",
    "trigger": "DbParameterExtensions: the caller invokes GetGuid",
    "response": "return Guid.Empty as the null marker, by design, instead of throwing",
    "postcondition": "no exception is thrown; a caller that must distinguish a database null from a stored empty Guid uses GetNullableGuid, which returns null for DBNull"
  },
