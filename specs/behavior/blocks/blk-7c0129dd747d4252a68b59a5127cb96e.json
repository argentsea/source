    "gwt": {
      "given": "on a little-endian runtime, a single-part key of type Guid (KeyDataType.Guid = 1)",
      "when": "TryEncodeTypeMetadata(typeof(Guid), out result) is invoked",
      "then": "it returns true and result is the single byte 0x04 -- the code 1 packed into the top 6 bits of a 1-byte result (1 << 2)"
