  "fields": {
    "gwt": {
      "given": "a data connection whose injected data provider services return true from GetIsErrorTransient for a deadlock DbException and false for a constraint-violation DbException, with a RetryCount of 3",
      "when": "one command fails with the deadlock exception and a later command fails with the constraint-violation exception",
      "then": "the resilience strategy retries the deadlocked command (waiting the configured retry backoff before each attempt) but does not retry the constraint-violation failure, which surfaces to the caller on its first occurrence"
    },
