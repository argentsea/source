    "subject": "ArgentSeaOrleansMembershipTable",
    "condition": "a cluster membership query contract returns a version row",
    "trigger": "the caller requests all membership records",
    "response": "construct the returned membership-table data from that version and every member row in the next result set, attaching each suspect row only to its referenced member",
