  "type": "Interface",
  "fields": {
    "name": "PgShardConnectionOptions.PgShardConnectionsConfiguration configuration surface",
    "kind": "Library",
    "language": "text",
    "contract": "PgShardConnectionOptions.PgShardConnectionsConfiguration represents one PostgreSQL shard-set configuration. It permits consumers to supply a shard-set name, a default shard identifier, a collection of PostgreSQL shard configurations, and distinct read and write configurations. Its IShardSetConnectionsConfiguration views expose the configured shard collection and read/write configurations as the corresponding shared-contract types; when values are assigned, the views expose those same configured values rather than replacements."
  },
