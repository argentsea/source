  "fields": {
    "name": "IDataConnection",
    "kind": "Library",
    "contract": "IDataConnection defines the connection-configuration values available to connection execution: a connection description; a connection string derived from configured connection properties; nullable retry-count, circuit-breaker failure-count, and circuit-breaker test-interval settings; and a retry time span selected for an attempt count. It accepts ambient configuration at global, read/write, shard-set, and shard scopes."
  },
