  "fields": {
    "name": "PgShardConnectionOptions.PgShardConnectionsConfiguration",
    "description": "The configurable PostgreSQL connection settings for one shard set; interface-only views are projections of the three concrete configuration members and are not separately stored fields.",
    "members": [
      {
        "name": "ShardSetName",
        "type": "nvarchar(max)",
        "required": false,
        "description": "Name of the shard set this configuration identifies."
      },
      {
        "name": "DefaultShardId",
        "type": "smallint",
        "required": true,
        "description": "Identifier of the default shard for this configuration."
      },
      {
        "name": "Shards",
        "type": "array<ref<PgShardConnectionOptions.PgShardConnectionConfiguration>>",
        "required": false,
        "description": "Concrete PostgreSQL configuration entries for the shards in the shard set."
      },
      {
        "name": "Read",
        "type": "ref<PgShardConnectionOptions.PgShardConnectionConfiguration>",
        "required": false,
        "description": "Concrete read configuration exposed through the read side of the read/write connection pair."
      },
      {
        "name": "Write",
        "type": "ref<PgShardConnectionOptions.PgShardConnectionConfiguration>",
        "required": false,
        "description": "Concrete write configuration exposed through the write side of the read/write connection pair."
      }
    ],
    "representations": {
      "C#": "public properties: string ShardSetName; short DefaultShardId; PgShardConnectionConfiguration[] Shards; PgShardConnectionConfiguration Read; PgShardConnectionConfiguration Write."
    }
  },
