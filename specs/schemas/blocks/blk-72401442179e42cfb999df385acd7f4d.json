  "specId": "schemas",
  "type": "Schema",
  "fields": {
    "name": "SqlParameters materialized parameter family",
    "description": "The SQL parameter shape produced by SqlParameters. It represents both scalar and structured parameter materialization and records the dimensions that vary across the extension family.",
    "members": [
      {
        "name": "Name",
        "type": "nvarchar(max)",
        "required": true,
        "description": "A parameter name normalized to begin with `@`."
      },
      {
        "name": "Direction",
        "type": "enum<Input|Output>",
        "required": true,
        "description": "Whether the parameter supplies a value or receives one."
      },
      {
        "name": "SqlType",
        "type": "enum<NVarChar|NChar|VarChar|Char|BigInt|Int|SmallInt|TinyInt|Float|Real|Bit|Decimal|Money|SmallMoney|Date|DateTime|DateTime2|Time|DateTimeOffset|UniqueIdentifier|VarBinary|Binary|Json|Structured>",
        "required": true,
        "description": "The overload-selected SQL Server type."
      },
      {
        "name": "Value",
        "type": "union<scalar|array<SqlDataRecord>>",
        "required": false,
        "description": "An input scalar, database null for nullable scalar inputs, or records for structured inputs."
      },
      {
        "name": "SizeOrLocaleOrPrecisionScale",
        "type": "object<SqlParameterTypeMetadata>",
        "required": false,
        "description": "Optional metadata supplied only by string, binary, or decimal family members."
      }
    ],
    "representations": {
      "CSharp": "SqlParameter with a normalized ParameterName, SqlDbType, Direction, and applicable Value/size/locale/precision/scale."
    }
  },
