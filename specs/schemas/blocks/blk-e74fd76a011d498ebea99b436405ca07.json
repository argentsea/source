  "type": "Schema",
  "fields": {
    "name": "QueryResultFormat",
    "description": "The shape in which a grain's read query returns its result: via stored-procedure/statement output parameters, or as a result set. Selected once per grain query-definition value (OrleansDbQueryDefinitions or OrleansShardQueryDefinitions) at construction and exposed unchanged via that value's ResultFormat member.",
    "members": [
      {
        "name": "OutputArgs",
        "type": "enum<OutputArgs|ResultSet>",
        "required": true,
        "description": "The read query's result is returned via output parameters rather than a result set."
      },
      {
        "name": "ResultSet",
        "type": "enum<OutputArgs|ResultSet>",
        "required": true,
        "description": "The read query's result is returned as a result set rather than via output parameters."
      }
    ],
    "representations": {
      "CSharp": "public enum QueryResultFormat { OutputArgs, ResultSet }"
    }
  },
