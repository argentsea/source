  "fields": {
    "name": "StringExtensions.InputCleaningOptions",
    "description": "Public option-set shape used to select StringExtensions.CleanInput character-cleaning behavior.",
    "members": [
      {
        "name": "CleanAll",
        "type": "int",
        "required": true,
        "description": "Value 0 selects default cleaning: leading and trailing separators, control characters, and surrogate-pair characters are omitted."
      },
      {
        "name": "AllowEmojis",
        "type": "int",
        "required": true,
        "description": "Value 1 is an independent flag that retains surrogate-pair characters."
      },
      {
        "name": "AllowMultiline",
        "type": "int",
        "required": true,
        "description": "Value 2 is an independent flag that converts each LF to CRLF while other control characters remain omitted."
      }
    ],
    "representations": {
      "CSharp": "[Flags] public enum with CleanAll = 0, AllowEmojis = 1, and AllowMultiline = 2; nonzero values may be combined."
    }
  },
