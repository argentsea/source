{
  "id": "blk-4491ecdb11c8413dbf6a235fd0af58d2",
  "specId": "schemas",
  "type": "Schema",
  "fields": {
    "name": "ShardKey<...> hierarchical key family shape",
    "description": "The four-arity virtual compound key family.",
    "members": [
      {
        "name": "GenericArity",
        "type": "enum<1|2|3|4>",
        "required": true,
        "description": "Number of ordered record-identity positions represented by a family variant."
      },
      {
        "name": "ShardId",
        "type": "smallint",
        "required": true,
        "description": "Shard identifier shared by every variant."
      },
      {
        "name": "RecordId",
        "type": "object<IComparable>",
        "required": true,
        "description": "First record-identity position."
      },
      {
        "name": "ChildId",
        "type": "object<IComparable>",
        "required": false,
        "description": "Second identity position, present in arities 2 through 4."
      },
      {
        "name": "GrandChildId",
        "type": "object<IComparable>",
        "required": false,
        "description": "Third identity position, present in arities 3 and 4."
      },
      {
        "name": "GreatGrandChildId",
        "type": "object<IComparable>",
        "required": false,
        "description": "Fourth identity position, present only in arity 4."
      }
    ],
    "representations": {
      "CSharp": "readonly value types ShardKey<TRecord>, ShardKey<TRecord,TChild>, ShardKey<TRecord,TChild,TGrandChild>, and ShardKey<TRecord,TChild,TGrandChild,TGreatGrandChild>; all generic identity types implement IComparable."
    }
  },
