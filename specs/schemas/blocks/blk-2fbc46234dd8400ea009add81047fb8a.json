  "fields": {
    "name": "IShardSetConnectionsConfiguration property shape",
    "description": "IShardSetConnectionsConfiguration is the provider-specific shard-set connection shape: it identifies a shard set, identifies its default shard, and exposes the member shard configurations plus the read and write connection configurations.",
    "members": [
      {
        "name": "ShardSetName",
        "type": "nvarchar(max)",
        "description": "The name identifying the shard set."
      },
      {
        "name": "DefaultShardId",
        "type": "smallint",
        "required": true,
        "description": "The identifier of the default shard."
      },
      {
        "name": "ShardsConfigInternal",
        "type": "array<ref<IShardConnectionConfiguration>>",
        "description": "The shard connection configurations in the shard set.",
        "notes": "Exposed through a getter only."
      },
      {
        "name": "ReadConfigInternal",
        "type": "ref<IShardConnectionConfiguration>",
        "description": "The read connection configuration for the shard set.",
        "notes": "Exposed through a getter only."
      },
      {
        "name": "WriteConfigInternal",
        "type": "ref<IShardConnectionConfiguration>",
        "description": "The write connection configuration for the shard set.",
        "notes": "Exposed through a getter only."
      }
    ],
    "representations": {
      "CSharp": "string ShardSetName { get; set; }; short DefaultShardId { get; set; }; IShardConnectionConfiguration[] ShardsConfigInternal { get; }; IShardConnectionConfiguration ReadConfigInternal { get; }; IShardConnectionConfiguration WriteConfigInternal { get; };"
    }
  },
