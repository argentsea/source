  "type": "Component",
  "fields": {
    "name": "Shard Key",
    "responsibility": "Represents a record's identity as the shard that holds it combined with one to four of the record's own key columns, so that an identity unique only within a shard becomes unique across the whole set. It owns how two such identities compare and hash, how a collection of them is merged or diffed against another, and how the set of foreign shards a collection refers to is derived. It also declares how a model exposes the identity it carries.",
    "parent": "sharding"
  },
