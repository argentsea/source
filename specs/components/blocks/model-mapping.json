{
  "id": "model-mapping",
  "specId": "components",
  "type": "Component",
  "fields": {
    "name": "Model Mapping",
    "responsibility": "Turns the mapping attributes a model type declares into a compiled, cached delegate that moves values between that model's properties and a command's input parameters, its output parameters, or a data reader's columns — including nested models, list properties filled from additional result sets, required values that make a missing row mean an absent record, and properties whose value is a record identity assembled from several columns. It owns the attribute vocabulary a model author writes against and the failures raised when a model's declarations are missing, duplicated or wrong for the property's type.",
    "parent": "mapping"
  },
