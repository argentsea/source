  "fields": {
    "name": "Connection Configuration Hierarchy",
    "responsibility": "Declares every connection attribute as a discrete setting that may be set at any level of an inheritable hierarchy, resolves the levels into the settings one read or write endpoint actually uses, and raises a change notification so a dependent endpoint re-resolves rather than serving a stale connection string. It also fixes what a resolved endpoint must be able to answer: its description, its connection string, and the retry and circuit-breaker limits that govern it.",
    "parent": "configuration"
  },
