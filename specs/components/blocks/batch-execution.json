{
  "id": "batch-execution",
  "specId": "components",
  "type": "Component",
  "fields": {
    "name": "Batch Execution",
    "responsibility": "Runs an ordered list of steps on one connection inside one transaction the library manages, committing only once every step has succeeded and rolling the whole list back otherwise — so that work which must be atomic is not split across connections. It owns how a step is declared, how a step's result is carried forward to the next, and the three scopes a batch can run in: one database, one shard, or every shard of a set.",
    "parent": "querying"
  },
