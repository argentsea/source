  "specId": "guidance",
  "type": "Guidance",
  "fields": {
    "body": "Never generate dynamic SQL from model types; keep all SQL external in `QueryProcedure` or `QueryStatement` definitions declared in a static `Queries` catalog. Decorate model properties with explicit provider-specific `[MapToSql*]` or `[MapToPg*]` attributes and never mix providers on a single model class. Treat `ShardKey<...>` as an immutable value type with a fixed `short` `ShardId` (`0` = empty), and always select `.Read` or `.Write` connection endpoints explicitly rather than relying on implicit routing or fallback.",
    "scope": "ambient",
    "title": "Core ArgentSea data-access working agreement"
  },
