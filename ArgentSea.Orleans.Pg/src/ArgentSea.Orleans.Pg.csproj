<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.1.0</Version>
    <Title>ArgentSea Microsoft Orleans persistence for PostgreSQL</Title>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<Copyright>© John Hicks</Copyright>
    <Description>Extension to enable ArgentSea to serve as a data provider for Microsoft Orleans, using standard PostgreSQL tables, functions and procedures.</Description>
	<PackageIcon>argentsea-logo.png</PackageIcon>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

	<PropertyGroup>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Orleans.Runtime" Version="10.4.0" />
		<PackageReference Include="Microsoft.Orleans.Reminders" Version="10.4.0" />
		<PackageReference Include="Microsoft.Orleans.Sdk" Version="10.4.0" />
		<None Include="readme.md" Pack="true" PackagePath="\" />
		<None Include="argentsea-logo.png" Pack="true" PackagePath="\" />
		<None Include="common.psql" Pack="true" PackagePath="sql\" />
		<None Include="tenant.psql" Pack="true" PackagePath="sql\" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\ArgentSea.Orleans\src\ArgentSea.Orleans.csproj" />
	  <ProjectReference Include="..\..\ArgentSea.Pg\src\ArgentSea.Pg.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="$(MSBuildProjectName).Test" />
	</ItemGroup>

</Project>
